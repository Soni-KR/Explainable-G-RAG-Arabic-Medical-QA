GROQ_API_KEY=your_groq_api_key_here
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
GRAPH_VERSION=final_v1
AHD_EMBEDDING_MODEL=intfloat/multilingual-e5-base
FINAL_GRAPH_VERSION=final_v1
FINAL_NEO4J_URI=bolt://localhost:7688
FINAL_NEO4J_DATABASE=neo4j
FINAL_EMBEDDING_MODEL=intfloat/multilingual-e5-base
FINAL_EMBEDDING_DIMENSION=768
FINAL_ENTITY_VECTOR_INDEX=final_medical_entity_vector_index
FINAL_EVIDENCE_VECTOR_INDEX=final_evidence_mention_vector_index
FINAL_QA_VECTOR_INDEX=final_qa_record_vector_index
ANSWER_GENERATION_PROVIDER=groq
ANSWER_GENERATION_MODEL=openai/gpt-oss-20b
ANSWER_GENERATION_REASONING_EFFORT=low
ANSWER_GENERATION_TEMPERATURE=0
ANSWER_GENERATION_PROMPT_VERSION=grounded_evidence_adaptive_v4_2
# New generation-only ablations should select grounded_claim_first_v3_1 with
# scripts/run_generation_ablation.py --answer-prompt-version rather than editing
# the frozen v3/v4 run configuration.

# Optional Step 14 semantic adjudication for claims rejected only by soft
# intent/concept/anatomy heuristics. Keep disabled until its labeled evaluation
# passes; deterministic verification remains the fallback.
# Frozen production remains deterministic_v3. hard_soft_v5 is opt-in only.
CLAIM_VERIFIER_PROFILE=deterministic_v3
CLAIM_ADJUDICATION_ENABLED=false
CLAIM_ADJUDICATION_PROVIDER=groq
CLAIM_ADJUDICATION_MODEL=openai/gpt-oss-20b
CLAIM_ADJUDICATION_REASONING_EFFORT=low
CLAIM_ADJUDICATION_TEMPERATURE=0
CLAIM_ADJUDICATION_PROMPT_VERSION=semantic_claim_adjudication_v2
CLAIM_ADJUDICATION_MAX_ATTEMPTS=1
CLAIM_ADJUDICATION_REQUEST_INTERVAL_SECONDS=8

# Conditional weak-context retrieval rescue. Disabled until its held-out pilot passes.
AHD_CROSS_ENCODER_RESCUE_ENABLED=false
AHD_CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
AHD_CROSS_ENCODER_CANDIDATE_K=30
AHD_CROSS_ENCODER_BATCH_SIZE=8
AHD_CROSS_ENCODER_WEIGHT=0.35
AHD_CROSS_ENCODER_MIN_SCORE=0.55
AHD_RELATION_TOP_K=30
AHD_CONTEXT_TOP_K=12
AHD_CONTEXT_MAX_ITEMS=6
AHD_CONTEXT_MIN_SCORE=0.40
AHD_CONTEXT_MIN_ANSWER_RELEVANCE=0.35
AHD_CONTEXT_MIN_SOURCE_RELIABILITY=0.55
AHD_CONTEXT_MIN_INTENT_SUPPORT=0.50
AHD_CONTEXT_MIN_AGGREGATE_CONCEPT_COVERAGE=0.25
AHD_CONTEXT_SEMANTIC_MIN_SCORE=0.84
AHD_SEMANTIC_SEED_THRESHOLD=0.72
AHD_QA_CORPUS_ENABLED=true
AHD_QA_CORPUS_INDEX=data/retrieval/ahd_qa_train_v1.sqlite
AHD_QA_CORPUS_VERSION=ahd_qa_train_v1
AHD_QA_LEXICAL_CANDIDATE_K=80
AHD_QA_SEMANTIC_TOP_K=8
AHD_QA_SEMANTIC_RERANK=false
AHD_QA_SEMANTIC_FALLBACK_ENABLED=true
AHD_QA_SEMANTIC_FALLBACK_CANDIDATE_K=40
