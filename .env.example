GROQ_API_KEY=your_groq_api_key_here
NEO4J_PASSWORD=your_neo4j_password_here

PRODUCTION_GRAPH_VERSION=final_v2
PRODUCTION_NEO4J_URI=bolt://localhost:7689
PRODUCTION_NEO4J_USERNAME=neo4j
PRODUCTION_NEO4J_DATABASE=neo4j
PRODUCTION_EMBEDDING_MODEL=intfloat/multilingual-e5-base
PRODUCTION_EMBEDDING_DIMENSION=768
PRODUCTION_ENTITY_VECTOR_INDEX=medical_entity_vector_index
PRODUCTION_EVIDENCE_VECTOR_INDEX=evidence_mention_vector_index
PRODUCTION_QA_VECTOR_INDEX=qa_record_vector_index

QUERY_ANALYSIS_MODEL=openai/gpt-oss-20b
ANSWER_GENERATION_MODEL=openai/gpt-oss-20b
CLAIM_VERIFIER_PROFILE=deterministic_v3

AHD_QA_CORPUS_ENABLED=false
AHD_QA_CORPUS_INDEX=data/retrieval/ahd_qa_train_v1.sqlite
